---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Bhadraksh Bhargava — Full-Stack Engineer";
const description = "I build fast systems that don't break. Flutter, React, Go, FastAPI, AI. Available for freelance engineering sprints.";
---

<BaseLayout title={title} description={description}>
    <a slot="nav-link" href="/about/" class="nav-link">ABOUT_ME</a>

    <div slot="floating-cta" class="floating-cta" id="floatingCta">
        <a class="floating-btn" href="#contact">BOOK_CALL</a>
    </div>

    <div slot="mobile-sticky-cta" class="mobile-sticky-cta" id="mobileStickyCta">
        <button class="mobile-btn" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">
            START_SPRINT →
        </button>
    </div>

    <Fragment slot="command-items">
        <div class="command-item" data-target="hero"><span class="name">Hero</span><span class="path">~/hero</span></div>
        <div class="command-item" data-target="problems"><span class="name">Problems</span><span class="path">~/problems</span></div>
        <div class="command-item" data-target="services"><span class="name">Services</span><span class="path">~/services</span></div>
        <div class="command-item" data-target="proof"><span class="name">Proof</span><span class="path">~/proof</span></div>
        <div class="command-item" data-target="outcomes"><span class="name">Outcomes</span><span class="path">~/outcomes</span></div>
        <div class="command-item" data-target="process"><span class="name">Process</span><span class="path">~/process</span></div>
        <div class="command-item" data-target="contact"><span class="name">Contact</span><span class="path">~/contact</span></div>
    </Fragment>

    <!-- ===== HERO SCENE ===== -->
    <section id="hero" class="scene hero-scene" data-scene="hero">
        <div class="scene-bg"><div class="hero-deco"></div></div>
        <div class="scene-stage">
            <span class="hero-label scene-layer" data-layer="label">// AVAILABLE FOR CONTRACT WORK</span>
            <h1 class="hero-title scene-layer" data-layer="title">I build fast systems that don't break.</h1>
            <p class="hero-subtitle scene-layer" data-layer="subtitle">
                Flutter apps. Go microservices. React frontends. AI features that actually ship.
                No hand-waving. No "we'll figure it out later." Just working code, delivered.
            </p>
            <div class="hero-ctas scene-layer" data-layer="ctas">
                <a href="#contact" class="btn-primary">GET_TECHNICAL_AUDIT →</a>
                <a href="/about/" class="btn-ghost">READ_CV</a>
            </div>
            <p class="hero-meta scene-layer" data-layer="meta">
                <span>4</span> PRODUCTION APPS · <span>60%</span> FASTER RELEASES · <span>99.9%</span> CRASH-FREE
            </p>
        </div>
    </section>

    <!-- ===== PROBLEMS SCENE ===== -->
    <section id="problems" class="scene problems-scene" data-scene="problems">
        <div class="scene-stage">
            <div class="section-header scene-layer" data-layer="header">
                <span class="section-label">01 — DIAGNOSIS</span>
                <h2>What's slowing you down?</h2>
                <p>Pick your pain. I'll show you the fix.</p>
            </div>

            <div class="problems-grid scene-layer" data-layer="content">
                <div class="problems-list">
                    <div class="problem-card active" data-solution="0">
                        <h3>Mobile backlog is blocking revenue</h3>
                        <p>Dual-platform teams can't ship fast enough</p>
                    </div>
                    <div class="problem-card" data-solution="1">
                        <h3>Monolith can't handle traffic</h3>
                        <p>Single codebase = single point of failure</p>
                    </div>
                    <div class="problem-card" data-solution="2">
                        <h3>Checkout is losing customers</h3>
                        <p>Slow APIs, clunky UX, dropped conversions</p>
                    </div>
                    <div class="problem-card" data-solution="3">
                        <h3>AI hype, zero implementation</h3>
                        <p>You need features, not PowerPoint decks</p>
                    </div>
                </div>

                <div class="solution-panel">
                    <div class="solution-content" data-solution="0">
                        <h3 class="solution-title">Flutter cross-platform sprint</h3>
                        <p class="solution-summary">One codebase. iOS + Android. Native feel. Fast.</p>
                        <div class="solution-outcome">-40% TIME TO RELEASE</div>
                        <p class="solution-details">
                            Shared business logic with platform-specific UI layers. CI/CD for both stores.
                            Cut cycle time 40%. 99.9% crash-free rate on production.
                        </p>
                    </div>
                </div>
            </div>

            <div class="section-cta scene-layer" data-layer="cta">
                <a href="#contact" class="btn-primary">FIX_MY_BOTTLENECK →</a>
            </div>
        </div>
    </section>

    <!-- ===== SERVICES SCENE ===== -->
    <section id="services" class="scene services-scene" data-scene="services">
        <div class="scene-stage">
            <div class="section-header scene-layer" data-layer="header">
                <span class="section-label">02 — ENGAGEMENTS</span>
                <h2>How I work</h2>
                <p>Fixed scope. Weekly demos. No surprises.</p>
            </div>

            <div class="services-grid scene-layer" data-layer="content">
                <div class="service-card" data-card="0">
                    <h3>MVP SPRINT</h3>
                    <span class="service-duration">4 WEEKS</span>
                    <div class="service-deliverables">
                        <div class="deliverable">Scoped roadmap with weekly milestones</div>
                        <div class="deliverable">Working build + metrics dashboard</div>
                        <div class="deliverable">TestFlight / Play Console ready</div>
                        <div class="deliverable">Handover docs + runbooks</div>
                    </div>
                    <div class="service-note">Ideal for: Pre-seed to Series A teams validating PMF</div>
                    <a href="#contact" class="btn-primary service-btn">REQUEST_PLAN →</a>
                </div>

                <div class="service-card" data-card="1">
                    <h3>SCALE & RELIABILITY</h3>
                    <span class="service-duration">3-4 WEEKS</span>
                    <div class="service-deliverables">
                        <div class="deliverable">Latency & bottleneck audit</div>
                        <div class="deliverable">CI/CD with rollback playbooks</div>
                        <div class="deliverable">Index strategy & query optimization</div>
                    </div>
                    <div class="service-note">Guarantee: if I don't find ≥20% p95 wins, you don't pay.</div>
                    <a href="#contact" class="btn-primary service-btn">AUDIT_MY_STACK →</a>
                </div>

                <div class="service-card" data-card="2">
                    <h3>AI INFUSION</h3>
                    <span class="service-duration">4-6 WEEKS</span>
                    <div class="service-deliverables">
                        <div class="deliverable">Use-case mapping → retention/activation</div>
                        <div class="deliverable">Agent workflows + RAG pipeline</div>
                        <div class="deliverable">Security & eval checklist</div>
                        <div class="deliverable">Analytics hooks for success metrics</div>
                    </div>
                    <div class="service-note">Intelligence that ships, not slides.</div>
                    <a href="#contact" class="btn-primary service-btn">AI_FEASIBILITY →</a>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== PROOF SCENE ===== -->
    <section id="proof" class="scene proof-scene" data-scene="proof">
        <div class="scene-stage">
            <div class="section-header scene-layer" data-layer="header">
                <span class="section-label">03 — EVIDENCE</span>
                <h2>Things I've actually built</h2>
                <p>No placeholder case studies. Real systems, real load, real results.</p>
            </div>

            <div class="proof-grid scene-layer" data-layer="content">
                <div class="proof-card" data-card="0">
                    <h3>Vet Clinic Platform</h3>
                    <p>Promo traffic caused 5% error spikes. Rebuilt as event-driven Go microservices on Cloud Run with RabbitMQ. Zero downtime during promos, handled 10x traffic spike.</p>
                    <div class="proof-tech">
                        <span class="tech-tag">Go</span>
                        <span class="tech-tag">RabbitMQ</span>
                        <span class="tech-tag">Cloud Run</span>
                        <span class="tech-tag">Flutter</span>
                    </div>
                </div>

                <div class="proof-card" data-card="1">
                    <h3>Google ADK Contribution</h3>
                    <p>Built real-time graph visualization for Google's Agent Development Kit. Turned multi-agent debugging from hours of log-reading into a 40-second visual scan.</p>
                    <div class="proof-tech">
                        <span class="tech-tag">TypeScript</span>
                        <span class="tech-tag">D3.js</span>
                        <span class="tech-tag">AI Agents</span>
                    </div>
                </div>

                <div class="proof-card" data-card="2">
                    <h3>E-Commerce API</h3>
                    <p>Checkout drop-offs from 600ms API calls. Indexed queries, async I/O, response caching. p95 dropped to 184ms. Checkout completion up 18%.</p>
                    <div class="proof-tech">
                        <span class="tech-tag">FastAPI</span>
                        <span class="tech-tag">MySQL</span>
                        <span class="tech-tag">JWT</span>
                    </div>
                </div>
            </div>

            <div class="section-cta scene-layer" data-layer="cta">
                <a href="#contact" class="btn-ghost">SHOW_ME_MORE_WINS →</a>
            </div>
        </div>
    </section>

    <!-- ===== OUTCOMES SCENE ===== -->
    <section id="outcomes" class="scene outcomes-scene" data-scene="outcomes">
        <div class="scene-stage">
            <div class="section-header scene-layer" data-layer="header">
                <span class="section-label">04 — METRICS</span>
                <h2>Numbers don't lie</h2>
                <p>Results from recent production work.</p>
            </div>

            <div class="outcomes-grid scene-layer" data-layer="content">
                <div class="outcome-card" data-outcome="0">
                    <div class="outcome-value" data-target="0">0</div>
                    <div class="outcome-label">P1 incidents (18mo)</div>
                    <div class="outcome-bar"><div class="outcome-fill" data-width="100"></div></div>
                </div>
                <div class="outcome-card" data-outcome="1">
                    <div class="outcome-value" data-target="99.9">99.9%</div>
                    <div class="outcome-label">Crash-free sessions</div>
                    <div class="outcome-bar"><div class="outcome-fill" data-width="99"></div></div>
                </div>
                <div class="outcome-card" data-outcome="2">
                    <div class="outcome-value" data-target="60">-60%</div>
                    <div class="outcome-label">Release cycle time</div>
                    <div class="outcome-bar"><div class="outcome-fill" data-width="60"></div></div>
                </div>
                <div class="outcome-card" data-outcome="3">
                    <div class="outcome-value" data-target="18">+18%</div>
                    <div class="outcome-label">Checkout conversion</div>
                    <div class="outcome-bar"><div class="outcome-fill" data-width="18"></div></div>
                </div>
            </div>

            <div class="section-cta scene-layer" data-layer="cta">
                <a href="#contact" class="btn-primary">GET_THESE_RESULTS →</a>
            </div>
        </div>
    </section>

    <!-- ===== PROCESS SCENE ===== -->
    <section id="process" class="scene process-scene" data-scene="process">
        <div class="scene-stage">
            <div class="section-header scene-layer" data-layer="header">
                <span class="section-label">05 — PROTOCOL</span>
                <h2>How we get from brief to build</h2>
                <p>No chaos. Clear milestones. Weekly demos. Delivered through <a href="https://sol4you.in" target="_blank" class="inline-link">Sol4you</a>.</p>
            </div>

            <div class="process-timeline scene-layer" data-layer="content">
                <div class="timeline-line"></div>
                <div class="process-step" data-step="0">
                    <div class="step-number">1</div>
                    <div class="step-content">
                        <h3>Discovery</h3>
                        <p>20 min call. Scope, stack, risks.</p>
                    </div>
                </div>
                <div class="process-step" data-step="1">
                    <div class="step-number">2</div>
                    <div class="step-content">
                        <h3>Audit</h3>
                        <p>48h. Risk map + execution plan.</p>
                    </div>
                </div>
                <div class="process-step" data-step="2">
                    <div class="step-number">3</div>
                    <div class="step-content">
                        <h3>Sprint</h3>
                        <p>Weekly builds. Loom updates. Ship.</p>
                    </div>
                </div>
                <div class="process-step" data-step="3">
                    <div class="step-number">4</div>
                    <div class="step-content">
                        <h3>Launch</h3>
                        <p>Docs. Runbooks. Handoff. Done.</p>
                    </div>
                </div>
            </div>

            <div class="section-cta scene-layer" data-layer="cta">
                <a href="#contact" class="btn-primary">SEND_MY_BRIEF →</a>
            </div>
        </div>
    </section>

    <!-- ===== CONTACT SCENE ===== -->
    <section id="contact" class="scene contact-scene" data-scene="contact">
        <div class="scene-stage">
            <div class="section-header scene-layer" data-layer="header">
                <span class="section-label">06 — CONTACT</span>
                <h2>Tell me what you're building</h2>
                <p>I'll reply within 24h. Usually with a Loom.</p>
            </div>

            <div class="contact-content scene-layer" data-layer="content">
                <form class="contact-form" id="contactForm" action="https://formspree.io/f/mvgqnrjg" method="POST">
                    <div class="form-group">
                        <label>Biggest challenge right now?</label>
                        <div class="pain-pills" role="group" aria-label="Pain points">
                            <input type="radio" id="pain-speed" name="pain_point" value="speed" class="pain-input" checked style="display:none;">
                            <label for="pain-speed" class="pain-pill">Ship faster</label>
                            <input type="radio" id="pain-scale" name="pain_point" value="scale" class="pain-input" style="display:none;">
                            <label for="pain-scale" class="pain-pill">Handle load</label>
                            <input type="radio" id="pain-mvp" name="pain_point" value="mvp" class="pain-input" style="display:none;">
                            <label for="pain-mvp" class="pain-pill">Build MVP</label>
                            <input type="radio" id="pain-ai" name="pain_point" value="ai" class="pain-input" style="display:none;">
                            <label for="pain-ai" class="pain-pill">Add AI</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="name">Name</label>
                        <input type="text" id="name" name="name" required>
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required>
                    </div>

                    <div class="form-group">
                        <label for="company">Company</label>
                        <input type="text" id="company" name="company" required>
                    </div>

                    <div class="form-group">
                        <label for="project">Project brief (2-3 lines)</label>
                        <textarea id="project" name="project" rows="3" required></textarea>
                        <small class="field-help">Stack, current blocker, success metric (e.g., p95 &lt;200ms).</small>
                    </div>

                    <button type="submit" class="btn-primary form-submit">REQUEST_AUDIT →</button>
                    <p class="form-note">NDA available. All IP stays with you.</p>
                </form>

                <div class="form-success hidden" id="formSuccess">
                    <h3>Message received.</h3>
                    <p>Expect a reply within 24 hours — often with a Loom walkthrough.</p>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
